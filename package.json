{
  "name": "french-fried",
  "productName": "French Fried!",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A single-player card game about discovering 1,001 french fry recipes.",
  "author": "French Fried! Team",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "http-server . -p 8080 -c-1 -o",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@fontsource/lilita-one": "5.2.5",
    "@fontsource/nunito": "5.2.5",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "http-server": "14.1.1"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  },
  "build": {
    "appId": "com.frenchfried.game",
    "productName": "French Fried!",
    "directories": { "output": "release" },
    "files": ["electron/**", "dist/**", "package.json"],
    "asarUnpack": ["node_modules/steamworks.js/**"],
    "win": { "target": ["dir", "nsis"], "icon": "build/icon.png" },
    "mac": { "target": ["dir", "dmg"], "category": "public.app-category.card-games", "icon": "build/icon.png" },
    "linux": { "target": ["dir", "AppImage"], "category": "Game", "icon": "build/icon.png" }
  }
}
