{
  "name": "backyard-league",
  "productName": "Backyard League",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build a backyard sports dynasty: recruit kids, earn money, survive school, win the league.",
  "author": "Backyard League Team",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build.mjs --dev && http-server dist -p 8090 -c-1 -o",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "data": "python3 tools/generate_kids.py",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@fontsource/lilita-one": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "http-server": "14.1.1"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  },
  "build": {
    "appId": "com.backyardleague.game",
    "productName": "Backyard League",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.sports-games"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
