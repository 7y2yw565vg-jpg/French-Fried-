{
  "name": "every-possible-book",
  "productName": "Every Possible Book",
  "version": "0.1.0",
  "private": true,
  "description": "An incremental game of word puzzles and literary horror, set in a library that is printing every possible book.",
  "author": "Every Possible Book Team",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build.mjs --dev && http-server dist -p 8095 -c-1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "sim": "node scripts/test.mjs --sim",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "steam:achievements": "node scripts/steam-achievements.mjs",
    "e2e": "npm run build && node tests/e2e.mjs",
    "steam:icons": "npm run build && node scripts/steam-icons.mjs"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-sans-glagolitic": "^5.3.0",
    "@fontsource/noto-sans-runic": "^5.3.0",
    "@types/node": "^22.15.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "http-server": "14.1.1",
    "pixi.js": "8.21.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  },
  "build": {
    "appId": "com.everypossiblebook.game",
    "productName": "Every Possible Book",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.simulation-games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}
